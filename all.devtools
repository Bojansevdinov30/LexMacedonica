                        <div class="cell25">                        
                        	<div class="smkIconDownload connectedDownloadCase">
                              <h5 style="margin:0">
									<a href="p0/IZ7_6G4408K0LOHF70AUE15A8Q24D7=CZ6_6G4408K0LGPU70AMD0HT9J2826=NJdocumentDownload=/?caseId=D09B4D89-4FFB-4FFD-99A8-00001287CB87&connected=false">Превземи предмет</a>							                               </h5>
